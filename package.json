{
  "name": "taste-plugin",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "A portable product-design plugin for existing coding harnesses",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gksoriginals/taste.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "validate:claude": "claude plugin validate .",
    "validate:package": "tsx scripts/validate-package.ts",
    "eval:report": "tsx scripts/eval-report.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
